# ============================================================
# NanoClaw 环境变量示例
#
# 用法：复制成 .env 再填自己的值
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# ★ 真实密钥只放 .env（已被 .gitignore 忽略），不要写进 config.json，
#   更不要提交到仓库。
# ============================================================

# ---- 模型服务 ----
NANOCLAW_API_KEY=sk-你的密钥
NANOCLAW_BASE_URL=https://api.deepseek.com

# ---- 模型档位（main 负责主循环，subagent / cheap 用于子 Agent 降本）----
NANOCLAW_MODEL_MAIN=deepseek-v4-pro
NANOCLAW_MODEL_SUBAGENT=deepseek-flash
NANOCLAW_MODEL_CHEAP=deepseek-flash

# ---- 渠道：飞书（留空则自动跳过飞书渠道）----
NANOCLAW_FEISHU_APP_ID=
NANOCLAW_FEISHU_APP_SECRET=

# ---- 渠道：QQ（留空则自动跳过 QQ 渠道）----
NANOCLAW_QQ_APP_ID=
NANOCLAW_QQ_APP_SECRET=

# ---- 渠道：Web ----
NANOCLAW_WEB_HOST=127.0.0.1
NANOCLAW_WEB_PORT=8080
